# =============================================================================
# Time Logger — environment variables
# =============================================================================
# Copy this file to `.env` (which is gitignored) and fill in real values.
# The setup wizard (`python -m timelogger setup`) can also write this for you.
# Never commit your `.env` file.
# =============================================================================

# --- Atlassian Jira ---------------------------------------------------------
# Your Atlassian email (the one you sign in to Jira with).
JIRA_EMAIL=

# API token from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# --- Google Sheets (optional) -----------------------------------------------
# Path to your OAuth client JSON. Get one at https://console.cloud.google.com/apis/credentials
# Choose "OAuth client ID" → "Desktop app". Leave commented out to disable Sheets.
GOOGLE_OAUTH_CLIENT_JSON=./secrets/google_oauth_client.json

# --- LLM polish (optional) --------------------------------------------------
# Pick which provider to use in config.yaml -> llm.provider:
#   claude_code  → uses the local `claude` CLI; no key needed (default).
#   anthropic    → uses Anthropic Messages API; requires ANTHROPIC_API_KEY.
#   gemini       → uses Google Gemini API; requires GEMINI_API_KEY.
#   off          → disabled; structured fallback only.

# Gemini API key — get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Anthropic API key — get one at https://console.anthropic.com (org plan required for team billing)
ANTHROPIC_API_KEY=

# Optional: override the path / command for the Claude Code CLI if it's not on PATH.
# CLAUDE_CODE_BIN=C:\Users\you\.local\bin\claude.exe
